<Window x:Class="PCDSQueue.Kiosk.Views.DepartmentQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Department Queue"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        MinWidth="1000"
        MinHeight="680"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="89*"/>
            <ColumnDefinition Width="161*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Grid.ColumnSpan="2">
            <Grid Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="BACK" Width="100" Height="42" VerticalAlignment="Center"
                        Background="White" Foreground="#1F4E91" BorderBrush="#1F4E91"
                        BorderThickness="1" FontWeight="SemiBold" Click="BackButton_Click" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="9" Background="#173F7A">
                        <TextBlock Text="Q" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="QUEUE" Foreground="#172033" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Self-Service Kiosk" Foreground="#718096" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#F59E0B"
                             Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ServerStatusText" Text="Checking server..."
                               Foreground="#718096" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2">
            <StackPanel HorizontalAlignment="Center" Margin="30,28,30,24">
                <TextBlock x:Name="DepartmentNameText" Text="CASHIER"
                           HorizontalAlignment="Center" Foreground="#172033"
                           FontSize="30" FontWeight="Bold" />
                <TextBlock Text="SCAN TO JOIN THE QUEUE ON YOUR PHONE"
                           HorizontalAlignment="Center" Foreground="#718096"
                           FontSize="12" FontWeight="SemiBold" Margin="0,6,0,18" />

                <Border Width="480" Padding="22" Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="SCAN WITH YOUR PHONE CAMERA" HorizontalAlignment="Center"
                                   Foreground="#172033" FontSize="13" FontWeight="Bold" />
                        <Border Width="230" Height="230" Background="White"
                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Grid>
                                <Image x:Name="QrImage" Stretch="Uniform" Margin="8" />
                                <TextBlock x:Name="QrLoadingText" Text="Preparing secure QR..."
                                           Foreground="#718096" FontSize="11" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="16" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Your queue number will appear on your phone."
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Foreground="#52657A"
                                   FontSize="12" Margin="0,10,0,2" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <TextBlock Text="WAITING" Foreground="#718096" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="WaitingCountText" Text="--" Foreground="#172033"
                                       FontSize="20" FontWeight="Bold" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="people" Foreground="#718096" FontSize="12"
                                       Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="QueueStateText" Text="Checking queue status..."
                                   HorizontalAlignment="Center" Foreground="#718096"
                                   FontSize="11" Margin="0,7,0,0" />
                        <TextBlock x:Name="ErrorText" Text="" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="#DC3545"
                                   FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Grid.ColumnSpan="2" Margin="0,595,0,0" Grid.RowSpan="2">
            <Grid Margin="40,0">
                <TextBlock Text="" VerticalAlignment="Center"
                           Foreground="#718096" FontSize="11" />
                <TextBlock Text="Scan the QR code with your phone camera to join"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#718096" FontSize="11" />
            </Grid>
        </Border>

    </Grid>
</Window>